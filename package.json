{
	"name": "h-bricks-elements",
	"private": true,
	"scripts": {
		"dev": "bun run dev:frontend",
		"dev:frontend": "vite build --watch --config vite.frontend.config.ts",
		"dev:admin": "vite build --watch --config vite.admin.config.ts",
		"build": "bun run build:frontend && bun run build:admin",
		"build:frontend": "vite build --config vite.frontend.config.ts",
		"build:admin": "vite build --config vite.admin.config.ts",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/bun": "latest",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.1.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.1"
	},
	"dependencies": {
		"@ant-design/icons": "^6.1.0",
		"antd": "^5.28.0",
		"flatpickr": "^4.6.13",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	}
}
