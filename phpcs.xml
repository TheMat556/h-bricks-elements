<?xml version="1.0"?>
<ruleset name="H-Bricks-Elements">
    <description>WordPress Coding Standards</description>

    <file>elements/</file>
    <file>plugin.php</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress"/>

    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>*</exclude-pattern>
    </rule>
</ruleset>
